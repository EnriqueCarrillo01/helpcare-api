# --- Obligatorias en producción ---
# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Orígenes del frontend autorizados por CORS, separados por comas.
CORS_ORIGIN=http://localhost:5500

# --- Base de datos ---
# Sin DATABASE_URL se usa un almacén en memoria (se borra al reiniciar).
DATABASE_URL=postgres://helpcare:helpcare@localhost:5432/helpcare
# "true" si el proveedor exige SSL desde fuera de su red (URL externa de Render).
DATABASE_SSL=false

# --- Primer administrador (se crea al arrancar si no existe) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administración HelpCare

# --- Opcionales ---
PORT=3000
JWT_EXPIRES_IN=2h
# Carga centros y necesidades de ejemplo en Villahermosa si la base está vacía.
SEED_DEMO=false
# Intentos permitidos por IP cada 15 minutos (login) y por hora (registro).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTRO=20
